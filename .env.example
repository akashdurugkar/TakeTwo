# --- Azure Content Understanding (Microsoft Foundry resource) ---
# Example: https://my-foundry-resource.cognitiveservices.azure.com
CU_ENDPOINT=
CU_KEY=
CU_API_VERSION=2025-11-01

# TakeTwo video analyzer. Existing deployment ID retained for compatibility.
CU_ANALYZER_ID=MakeItReelAnalyzer
# Base analyzer the custom video analyzer extends.
CU_BASE_ANALYZER_ID=prebuilt-video
# Fallback base analyzer if the primary one is unavailable in your region.
CU_FALLBACK_BASE_ANALYZER_ID=
# Prebuilt analyzer used when custom analyzer creation fails entirely.
CU_PREBUILT_ANALYZER_ID=prebuilt-videoSearch

# --- Azure OpenAI (TakeTwo creative team) ---
# Example: https://my-aoai-resource.openai.azure.com
AOAI_ENDPOINT=
AOAI_KEY=
AOAI_DEPLOYMENT=gpt-4.1
AOAI_API_VERSION=2024-10-21

# --- App ---
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_CALLS=3
WEB_SEARCH_TIMEOUT_SECONDS=45
MAX_UPLOAD_MB=200

# Optional private staging for local videos larger than the direct-upload limit.
# Local development uses the current Azure CLI login; no storage keys are required.
BLOB_ACCOUNT_NAME=
BLOB_CONTAINER=taketwo-uploads
BLOB_TENANT_ID=
BLOB_USE_MANAGED_IDENTITY=false
MAX_BLOB_UPLOAD_BYTES=4000000000
CU_ANALYSIS_TIMEOUT_SECONDS=7200
